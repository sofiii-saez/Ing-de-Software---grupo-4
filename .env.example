# 1) Copia este archivo:   cp .env.example .env     (en Windows: copy .env.example .env)
# 2) Pega tu key de Gemini (https://aistudio.google.com → Claves de API). NUNCA subas .env a GitHub.
#    Sin key, el asistente funciona igual, solo con el buscador.
API_KEY=PEGA_AQUI_TU_API_KEY
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL=gemini-2.5-flash
# Si el modelo principal llega a su límite del plan gratuito (error 429), se usa este:
MODEL_RESPALDO=gemini-2.5-flash-lite
# Espacio total para que Gemini piense + responda, y cuánto piensa ("low", "medium" o "ninguno")
LLM_MAX_TOKENS=8192
LLM_RAZONAMIENTO=low
PORT=3000

# Administrador del panel. NO lo escribas a mano: ejecuta  npm run crear-admin
ADMIN_USER=
ADMIN_PASS_HASH=